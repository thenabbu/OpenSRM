.git
.github
.gitignore
# local coredumps from interpreter aborts — process memory, must never ship
core.*
.ruff_cache
.venv
__pycache__
*.pyc
*.pyo
.env
*.db
/data/
*.egg-info/
dist/
build/
.vscode/
.idea/
Dockerfile
docker-compose.yml
README.md
CONTRIBUTING.md
SECURITY.md
LICENSE
ruff.toml
requirements.txt
docs/
# agent/design docs — read from the checkout, never at runtime
AGENTS.md
DESIGN.md
# audit: research PoCs (had a hardcoded proxy token) must never ship in the image
egress/
# not runtime code: suites run in CI from the checkout, deploy helpers run on
# the host — neither belongs in the shipped image
tests/
# observability stack: runs NEXT TO the app on the host (ops/observability),
# never inside its image
ops/
scripts/
# ...except the two operational tools the runbooks invoke INSIDE the container:
# SECURITY.md's key-rotation runbook (`docker exec opensrm python
# /app/scripts/rotate_fernet_key.py`) and the README sync-health canary
# (`docker exec opensrm python /app/scripts/canary_cookie.py`, the default
# MINT/CHECK/DROP of scripts/canary_sync.sh). Dropping them silently breaks
# both runbooks, so they stay in the image.
!scripts/rotate_fernet_key.py
!scripts/canary_cookie.py
docker-compose.dev.yml
