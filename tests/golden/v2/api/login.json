{
  "body": "<!doctype html>\n<html data-theme=\"openSRM\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1, viewport-fit=cover\">\n<link rel=\"icon\" type=\"image/x-icon\" href=\"/static/favicon.ico\">\n<link rel=\"icon\" type=\"image/png\" sizes=\"192x192\" href=\"/static/icon-192.png\">\n<link rel=\"icon\" type=\"image/png\" sizes=\"512x512\" href=\"/static/icon-512.png\">\n<link rel=\"apple-touch-icon\" href=\"/static/apple-touch-icon.png\">\n<link rel=\"manifest\" href=\"/static/manifest.json\">\n<meta name=\"theme-color\" content=\"#111111\">\n<meta name=\"apple-mobile-web-app-capable\" content=\"yes\">\n<meta name=\"apple-mobile-web-app-status-bar-style\" content=\"black-translucent\">\n<meta name=\"apple-mobile-web-app-title\" content=\"OpenSRM\">\n<meta name=\"mobile-web-app-capable\" content=\"yes\">\n<meta name=\"msapplication-TileColor\" content=\"#111111\">\n<meta name=\"msapplication-TileImage\" href=\"/static/icon-192.png\">\n<meta name=\"description\" content=\"Self-hosted attendance dashboard for the SRM Student Portal.\">\n<meta name=\"robots\" content=\"noindex, nofollow\">\n<meta property=\"og:type\" content=\"website\">\n<meta property=\"og:title\" content=\"OpenSRM - Student Attendance Dashboard\">\n<meta property=\"og:description\" content=\"Self-hosted attendance dashboard for the SRM Student Portal.\">\n<meta property=\"og:image\" content=\"https://srm.200871.xyz/static/icon-512.png\">\n<meta property=\"og:url\" content=\"https://srm.200871.xyz\">\n<meta property=\"og:site_name\" content=\"OpenSRM\">\n<meta name=\"twitter:card\" content=\"summary\">\n<meta name=\"twitter:title\" content=\"OpenSRM - Student Attendance Dashboard\">\n<meta name=\"twitter:description\" content=\"Self-hosted attendance dashboard for the SRM Student Portal.\">\n<meta name=\"twitter:image\" content=\"https://srm.200871.xyz/static/icon-512.png\">\n<title>OpenSRM</title>\n<script src=\"/static/perf.js\"></script>\n<meta name=\"color-scheme\" content=\"dark\">\n<style>\nhtml[data-theme=\"openSRM\"] {\n  --color-base-100: oklch(20% 0 0); --color-base-200: oklch(14% 0 0);\n  --color-base-300: oklch(26% 0 0); --color-base-content: oklch(100% 0 0);\n  --color-primary: oklch(0% 0 0); --color-primary-content: oklch(100% 0 0);\n  --color-secondary: oklch(65% 0.241 354.308); --color-secondary-content: oklch(97% 0.014 343.198);\n  --color-accent: oklch(100% 0 0); --color-accent-content: oklch(0% 0 0);\n  --color-neutral: oklch(26% 0 0); --color-neutral-content: oklch(98% 0 0);\n  --color-info: oklch(58% 0.158 241.966); --color-info-content: oklch(97% 0.013 236.62);\n  --color-success: oklch(76% 0.177 163.223); --color-success-content: oklch(98% 0.014 180.72);\n  --color-warning: oklch(68% 0.162 75.834); --color-warning-content: oklch(98% 0.026 102.212);\n  --color-error: oklch(57% 0.245 27.325); --color-error-content: oklch(97% 0.013 17.38);\n  --radius-selector: 0.5rem; --radius-field: 0.5rem; --radius-box: 0.5rem;\n  --size-selector: 0.25rem; --size-field: 0.25rem; --border: 1px; --depth: 1; --noise: 0;\n  color-scheme: dark;\n}\n/* Selected navbar tab — two cues on purpose. The tint is the subtle background\n   the bar needs; the 2px currentColor bar is the non-color state signal\n   (WCAG 1.4.1 — same bar the mobile dock's .dock-active draws). daisyUI's own\n   .btn-active fills base-200 with 5% black = #090909, byte-identical to this\n   bar, so it could never show (DESIGN §10.11). Tint = 1.25:1 vs the navbar\n   (the base-300 over base-200 step, §2.3); bar = 19.9:1. */\n.navbar [role=\"tab\"][aria-selected=\"true\"] {\n  position: relative;\n  background-color: color-mix(in oklab, var(--color-base-content) 10%, transparent);\n}\n.navbar [role=\"tab\"][aria-selected=\"true\"]::after {\n  content: \"\";\n  position: absolute;\n  width: auto;          /* daisyUI .dock-active:after sets width:2.5rem and dash.js\n                           toggles that class on every [data-tab] — without this the\n                           bar renders 40px (left 8 / right 41) instead of the\n                           left/right-derived width. Measured: 73px in, 40px leaked. */\n  left: 0.5rem;\n  right: 0.5rem;\n  bottom: 2px;\n  height: 2px;\n  background: currentColor;\n}\n/* Scroll affordance (v1.32.0): a thin, self-hiding overlay bar on desktop only.\n   NOT scrollbar-gutter:stable — that reserved a 15px dead strip on every page\n   (on phones too, where there is no scrollbar at all) and pushed the navbar's\n   right edge off the viewport edge. The bar is drawn OVER the content, so it\n   costs no layout width and the layout never moves when it appears.\n   Chromium/Safari: width 0 until the page is hovered or scrolled, then a 6px\n   rounded thumb at 35% white. Firefox has no hover state for ::-webkit-*, so\n   it gets the standard props: thin + a faint thumb, same colour.\n   Touch platforms never scroll with a visible bar -> hidden outright. */\n@media (hover: hover) and (pointer: fine) {\n  html { scrollbar-width: thin;\n         scrollbar-color: color-mix(in oklab, var(--color-base-content) 35%, transparent) transparent; }\n}\n@media (hover: none), (pointer: coarse) {\n  html { scrollbar-width: none; }\n  html::-webkit-scrollbar { display: none; }\n}\n@supports selector(::-webkit-scrollbar) {\n  @media (hover: hover) and (pointer: fine) {\n    html { scrollbar-width: auto; scrollbar-color: auto; }\n    /* width 0 keeps it out of the way; the hover/scroll state below gives it\n       its 6px back. Track is always transparent — no gutter, no strip. */\n    html::-webkit-scrollbar { width: 0; height: 0; }\n    html::-webkit-scrollbar-track,\n    html::-webkit-scrollbar-corner { background: transparent; }\n    html::-webkit-scrollbar-thumb {\n      background: transparent;\n      border-radius: 9999px;\n      transition: background-color 200ms ease-out;\n    }\n    html:hover::-webkit-scrollbar,\n    html.is-scrolling::-webkit-scrollbar { width: 6px; height: 6px; }\n    html:hover::-webkit-scrollbar-thumb,\n    html.is-scrolling::-webkit-scrollbar-thumb {\n      background: color-mix(in oklab, var(--color-base-content) 35%, transparent);\n    }\n    html::-webkit-scrollbar-thumb:hover {\n      background: color-mix(in oklab, var(--color-base-content) 55%, transparent);\n    }\n  }\n}\n/* First paint is dark even before app.css parses — no color jump\n   (the data-theme block above paints the tokens this matches). */\nhtml { background: oklch(20% 0 0); }\n</style>\n<link rel=\"stylesheet\" href=\"/static/app.css\"></head>\n<body class=\"bg-base-100 text-base-content min-h-[100dvh] flex flex-col\">\n\n  <!-- Main content -->\n  <main class=\"flex-1 flex items-center justify-center p-4 sm:p-6\">\n    <div class=\"w-full max-w-md\">\n\n      <!-- Single card: logo + form -->\n      <div class=\"card bg-base-200 border border-base-300\">\n        <figure>\n          <img src=\"/static/logo-rect.png\" alt=\"OpenSRM\" width=\"400\" height=\"120\"\n               class=\"w-full h-auto\">\n        </figure>\n        <!-- Brand band group break: STEPS with the card's own padding (p-6 -> p-8),\n               never a pinned pixel. It tracks the password -> Sign in break exactly:\n               24px below sm (mt-2), 36px at sm+ (mt-5) + the 16px reserved caps row. -->\n        <div class=\"card-body p-6 sm:p-8 pt-6 sm:pt-9\">\n\n          <!-- Form. Vertical gaps are RANKED by relationship, never uniform\n               (DESIGN §5 rhythm, Gestalt proximity): attached 0 < feedback 8\n               < peers 12 < group/section 20. Horizontal gutter stays uniform. -->\n          <form id=\"f\" class=\"flex flex-col\">\n\n            <!-- NetID / Email — floating label + leading icon (DESIGN §4.6) -->\n            <label class=\"floating-label w-full\" for=\"netid\">\n              <svg xmlns=\"http://www.w3.org/2000/svg\" fill=\"none\" viewBox=\"0 0 24 24\"\n                   stroke-width=\"1.5\" stroke=\"currentColor\" aria-hidden=\"true\"\n                   class=\"pointer-events-none absolute start-3 top-1/2 z-10 h-5 w-5 -translate-y-1/2 opacity-50\">\n                <path stroke-linecap=\"round\" stroke-linejoin=\"round\"\n                      d=\"M15.75 6a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0ZM4.502 20.118a7.5 7.5 0 0 1 14.996 0A17.933 17.933 0 0 1 12 21.75c-2.676 0-5.216-.584-7.498-1.632Z\"/>\n              </svg>\n              <input type=\"text\" id=\"netid\" name=\"netid\" placeholder=\"NetID / SRM email\"\n                     required autocomplete=\"username webauthn\" inputmode=\"email\"\n                     autocapitalize=\"off\" autocorrect=\"off\" spellcheck=\"false\" maxlength=\"50\"\n                     class=\"input input-lg w-full text-base ps-10\">\n              <span>NetID / Email</span>\n            </label>\n\n            <!-- Password — floating label + leading icon + show/hide toggle.\n                 mt-3 (12px) = peer of the NetID field, same group -->\n            <div class=\"mt-3\">\n              <div class=\"relative\">\n                <label class=\"floating-label w-full\" for=\"pw\">\n                  <svg xmlns=\"http://www.w3.org/2000/svg\" fill=\"none\" viewBox=\"0 0 24 24\"\n                       stroke-width=\"1.5\" stroke=\"currentColor\" aria-hidden=\"true\"\n                       class=\"pointer-events-none absolute start-3 top-1/2 z-10 h-5 w-5 -translate-y-1/2 opacity-50\">\n                    <path stroke-linecap=\"round\" stroke-linejoin=\"round\"\n                          d=\"M16.5 10.5V6.75a4.5 4.5 0 1 0-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 0 0 2.25-2.25v-6.75a2.25 2.25 0 0 0-2.25-2.25H6.75a2.25 2.25 0 0 0-2.25 2.25v6.75a2.25 2.25 0 0 0 2.25 2.25Z\"/>\n                  </svg>\n                  <input type=\"password\" id=\"pw\" name=\"password\" placeholder=\"Password\"\n                         required autocomplete=\"current-password\" maxlength=\"128\"\n                         class=\"input input-lg w-full text-base ps-10 pe-12\">\n                  <span>Password</span>\n                </label>\n                <button type=\"button\" id=\"pw-toggle\"\n                        class=\"absolute end-1 top-1/2 -translate-y-1/2 btn btn-ghost btn-sm btn-square h-11 w-11\"\n                        aria-label=\"Toggle password visibility\">\n                  <svg id=\"pw-eye-open\" xmlns=\"http://www.w3.org/2000/svg\" fill=\"none\" viewBox=\"0 0 24 24\"\n                       stroke-width=\"1.5\" stroke=\"currentColor\" class=\"w-5 h-5\">\n                    <path stroke-linecap=\"round\" stroke-linejoin=\"round\"\n                          d=\"M2.036 12.322a1.012 1.012 0 0 1 0-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178Z\"/>\n                    <path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z\"/>\n                  </svg>\n                  <svg id=\"pw-eye-closed\" xmlns=\"http://www.w3.org/2000/svg\" fill=\"none\" viewBox=\"0 0 24 24\"\n                       stroke-width=\"1.5\" stroke=\"currentColor\" class=\"w-5 h-5 hidden\">\n                    <path stroke-linecap=\"round\" stroke-linejoin=\"round\"\n                          d=\"M3.98 8.223A10.477 10.477 0 0 0 1.934 12C3.226 16.338 7.244 19.5 12 19.5c.993 0 1.953-.138 2.863-.395M6.228 6.228A10.451 10.451 0 0 1 12 4.5c4.756 0 8.773 3.162 10.065 7.498a10.522 10.522 0 0 1-4.293 5.774M6.228 6.228 3 3m3.228 3.228 3.65 3.65m7.894 7.894L21 21m-3.228-3.228-3.65-3.65m0 0a3 3 0 1 0-4.243-4.243m4.242 4.242L9.88 9.88\"/>\n                  </svg>\n                </button>\n              </div>\n              <!-- Caps Lock hint: row is always reserved so nothing shifts on show -->\n              <p id=\"caps\" class=\"h-4 text-right text-xs leading-4 text-warning\" aria-live=\"polite\"></p>\n            </div>\n\n            <!-- Submit button: mt-5 (20px) — the credential group ends here,\n                 the action is a different group (DESIGN §5 \"mb-5 between blocks\") -->\n            <!-- group break: 8px below sm (16 caps row + 8 = 24), 20px at sm+ (16 + 20 = 36) -->\n            <button type=\"submit\" id=\"b\" class=\"btn btn-accent btn-lg w-full mt-2 sm:mt-5\">\n              <span class=\"loading loading-spinner loading-sm hidden\" id=\"loginSpinner\"></span>\n              <span id=\"btnLabel\">Sign in</span>\n            </button>\n\n          </form>\n\n          <!-- Status/progress: card-body gap-2 (8px) hugs them to the button they\n               report on — attached feedback, tighter than peer fields. -->\n          <div id=\"status\" role=\"alert\" aria-live=\"polite\" class=\"text-center text-sm\"></div>\n          <div id=\"progressWrap\" class=\"hidden\">\n            <progress id=\"progressBar\" class=\"progress w-full\" max=\"100\" value=\"0\"></progress>\n          </div>\n\n          <!-- Section break: mt-3 (12px) on top of the card-body gap (8px) = 20px of\n               pause before the rule, then pt-3 inside it — loosest gap in the card. -->\n          <div class=\"mt-3 text-center text-xs text-base-content/50 leading-relaxed border-t border-base-300 pt-3\">\n            SRM Student Portal login · auto-solve captcha · server-side caching\n          </div>\n\n        </div>\n      </div>\n\n      <!-- Version -->\n      <p class=\"text-center text-[10px] text-base-content/30 font-mono mt-4 select-none\">OpenSRM v2.11.0</p>\n\n    </div>\n  </main>\n\n  <!-- Safe area padding for iOS -->\n  <div class=\"h-[env(safe-area-inset-bottom)]\"></div>\n\n  <script src=\"/static/login.js\"></script>\n</body>\n</html>",
  "bytes": 13133,
  "content_type": "text/html; charset=utf-8",
  "gzip_bytes": 4567,
  "path": "/login",
  "status": 200
}
