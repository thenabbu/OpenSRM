__pycache__/
*.pyc
*.pyo
# local coredumps (the onnxruntime/ddddocr teardown abort) — process memory,
# never committed and never shipped in the image
core.*
.env
*.db
*.log
*.log.*
/data/
*.egg-info/
dist/
build/
# committed build output (served statically; see scripts/build-web.sh)
!app/static/dist/
!app/static/dist/**
# pnpm install in web/ (builds run on the laptop, never commit)
web/node_modules/
.vscode/
.idea/
requirements.txt
.shots-*/
# observability stack secrets — created on the deploy host only, never committed
ops/observability/secrets/

ops/observability/proof-override.yml
ops/observability/proof/
/node_modules/
.venv/
.venv

# dev-lan.sh bind-mount
.dev-lan-data/
